# Copy nothing secret here. Real secrets stay in the environment.
# Local development defaults (match docker-compose.yml):

# API + worker runtime (PostgreSQL source of truth):
DATABASE_URL=postgres://omnilinks:omnilinks@localhost:5432/omnilinks

# Migration runner (defaults to DATABASE_URL when unset):
# MIGRATION_DATABASE_URL=postgres://omnilinks:omnilinks@localhost:5432/omnilinks

# Backend test suite (CI sets this to its Postgres service):
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/omnilinks_test

# Identity provider: "dev" outside production. Production refuses to boot
# with "dev" and no production provider is implemented yet.
IDENTITY_PROVIDER=dev
NODE_ENV=development
PORT=4000

# Operator inbox browser app:
NEXT_PUBLIC_OMNILINKS_API_URL=http://localhost:4000
