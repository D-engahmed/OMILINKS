diff --git a/packages/backend/migrations/0003_session_expiry.sql b/packages/backend/migrations/0003_session_expiry.sql
new file mode 100644
index 0000000..9cae93a
--- /dev/null
+++ b/packages/backend/migrations/0003_session_expiry.sql
@@ -0,0 +1,8 @@
+-- Sessions must always expire. Any pre-existing non-expiring session is
+-- expired immediately rather than being grandfathered in.
+BEGIN;
+
+UPDATE sessions SET expires_at = created_at WHERE expires_at IS NULL;
+ALTER TABLE sessions ALTER COLUMN expires_at SET NOT NULL;
+
+COMMIT;
