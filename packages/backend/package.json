{
  "name": "@workspace/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test --test-concurrency=1 dist/*.test.js",
    "migrate": "tsc && node dist/migrate-cli.js",
    "worker": "tsc && node dist/worker.js"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "prettier": "^3.8.3",
    "typescript": "^5"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
